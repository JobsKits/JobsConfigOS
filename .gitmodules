# JobsCodeSnippets 两平台仓库名不同，保留已确认的 Gitee 地址；其它同名仓库跟随父仓远端。
[submodule "🍎JobsCodeSnippets"]
	path = 🍎JobsCodeSnippets
	url = https://gitee.com/JobsGo/jobs-code-snippetsJobsCodeSnippets.git
	branch = main
[submodule "💻JobsCodexConfigs"]
	path = 💻JobsCodexConfigs
	url = ../JobsCodexConfigs.git
	branch = main
[submodule "🔨JobsConfigHotKeyByHammerspoon"]
	path = 🔨JobsConfigHotKeyByHammerspoon
	url = ../JobsConfigHotKeyByHammerspoon.git
	branch = main
[submodule "🦞JobsInstallOpenClaw"]
	path = 🦞JobsInstallOpenClaw
	url = ../JobsInstallOpenClaw.git
	branch = main
[submodule "🌍JobsMacEnvVarConfigs"]
	path = 🌍JobsMacEnvVarConfigs
	url = ../JobsMacEnvVarConfigs.git
	branch = main
[submodule "⏬JobsSoftware.MacOS"]
	path = ⏬JobsSoftware.MacOS
	url = ../JobsSoftware.MacOS.git
	branch = main
[submodule "Obsidian"]
	path = 📒CodexByObsidian
	url = ../CodexByObsidian.git
	branch = main
[submodule "⚙️VScodeConfigs"]
	path = ⚙️VScodeConfigs
	url = ../VScodeConfigs.git
	branch = main
